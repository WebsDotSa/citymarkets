#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────
# citymarket_db weekly restore test (PCP-215)
#
# Pulls the most recent daily backup, restores it into a throwaway
# database, counts the rows in a few representative tables, and
# drops the test DB. If any of the row counts are unexpectedly
# zero (or the restore itself errors out), the script logs a
# loud failure.
#
# Why this exists (PCP-215): the Phase 16 audit found that
# backups had never been tested in the last 90 days. A
# `pg_dump` cron that runs nightly is worthless if the dumps
# are corrupt — this script is the safety net that catches
# silent corruption within 7 days of the daily run that
# introduced it.
#
# Runs as root via /etc/cron.d/citymarket-db-backup on Sundays
# at 03:30 (after the 02:00 daily backup has finished).
#
# Tested live: 2026-10-03 01:42 UTC.
# ─────────────────────────────────────────────────────────────────

set -euo pipefail

set -o errtrace
trap 'echo "[$(date -Iseconds)] FAILED at line $LINENO (exit $?)" >> /var/log/citymarket-db-restore-test.log' ERR

ENV_FILE="/var/www/citymarkets.sa/city-market-app/.env"
BACKUP_DIR="/var/backups/citymarket_db"
LOG_FILE="/var/log/citymarket-db-restore-test.log"
TEST_DB="restore_test_$(date -u +%Y%m%d_%H%M%S)"

# Pick the most recent daily dump. If there isn't one, fail
# loudly — a missing backup chain is exactly the silent failure
# mode this script is supposed to catch.
LATEST="$(ls -1t "$BACKUP_DIR"/citymarket_db-*.sql.gz 2>/dev/null | head -1 || true)"
if [[ -z "$LATEST" ]]; then
  echo "[$(date -Iseconds)] FAILED: no backup file in $BACKUP_DIR" >> "$LOG_FILE"
  exit 1
fi

# Locate the citymarket-db container.
DB_CONTAINER="$(docker ps --filter 'name=^/citymarket-db$' --format '{{.Names}}' | head -1 || true)"
if [[ -z "$DB_CONTAINER" ]]; then
  echo "[$(date -Iseconds)] FAILED: citymarket-db container is not running" >> "$LOG_FILE"
  exit 1
fi

mkdir -p "$(dirname "$LOG_FILE")"

echo "[$(date -Iseconds)] starting restore test from $LATEST" >> "$LOG_FILE"

# Always drop the test DB on exit, success or failure.
cleanup() {
  docker exec -u postgres "$DB_CONTAINER" dropdb --if-exists "$TEST_DB" >/dev/null 2>&1 || true
}
trap cleanup EXIT

# Create the test DB first.
docker exec -u postgres "$DB_CONTAINER" createdb "$TEST_DB" >/dev/null

# Restore.
gunzip -c "$LATEST" | docker exec -i -u postgres "$DB_CONTAINER" psql -d "$TEST_DB" -v ON_ERROR_STOP=1 >/dev/null

# Compare key table counts against the live DB. A difference
# bigger than 1% on `users` or `app_migrations` is treated as
# a failure. The exact threshold is a function of how chatty
# the app is — `users` grows by ~5/day in the current production
# so a >1% drift over 7 days is the floor.
for table in users app_migrations products vendor_products orders; do
  live=$(docker exec -u postgres "$DB_CONTAINER" psql -d citymarket_db -tA -c "SELECT count(*) FROM $table")
  restored=$(docker exec -u postgres "$DB_CONTAINER" psql -d "$TEST_DB" -tA -c "SELECT count(*) FROM $table")
  if [[ "$live" != "$restored" ]]; then
    echo "[$(date -Iseconds)] FAILED: table $table row count differs — live=$live restored=$restored" >> "$LOG_FILE"
    exit 1
  fi
done

# Check the policy coverage matches: defensive migrations (105, 108)
# added 38 RLS policies; we expect at least 35 still active. If the
# restore skipped RLS we want to know.
POLICIES=$(docker exec -u postgres "$DB_CONTAINER" psql -d "$TEST_DB" -tA -c "SELECT count(*) FROM pg_policies WHERE schemaname='public'")
if [[ "$POLICIES" -lt 35 ]]; then
  echo "[$(date -Iseconds)] FAILED: expected ≥35 RLS policies, found $POLICIES" >> "$LOG_FILE"
  exit 1
fi

echo "[$(date -Iseconds)] ok: restore from $LATEST matches live (users/orders/products/app_migrations/policies=$POLICIES)" >> "$LOG_FILE"

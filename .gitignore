# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/.next-cache-host/
/out/

# Driver credentials — generated by scripts/create_drivers.js
# Never commit these; they contain plaintext initial passwords.
.driver-passwords-*.txt

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# Cloudflare R2 credentials (server-only, mode 600)
.env.r2

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local settings (user-specific overrides, not for the team)
.claude/settings.local.json

# Claude Code agent worktrees (temporary clones used by spawned agents)
/.claude/worktrees/

# Editor / IDE-specific files (Cursor, VSCode user settings)
.cursor/
.vscode/

# user uploads (large, served from /public, not committed)
/public/images/products/**
/public/images/banners/**
/public/images/categories/**
/public/images/employment/**

# pm2 logs (rotated by pm2-logrotate)
/logs/
/pm2-*.log
/server.log/

# Diagnostic reports generated by scripts/ (drift-report, auth-isolation-audit).
# Re-generated on demand; never committed.
/scripts/out/

# iOS / Xcode (generated by xcodegen / xcodebuild)
ios/.build/
ios/build/
ios/DerivedData/
ios/CityMarkets.xcodeproj/
ios/CityMarkets.xcworkspace/
ios/CityMarkets.xcodeproj/xcuserdata/
ios/CityMarkets.xcodeproj/project.xcworkspace/xcuserdata/
ios/CityMarkets.xcworkspace/xcuserdata/
ios/Pods/
ios/Podfile.lock
ios/fastlane/report.xml
ios/fastlane/Preview.html
ios/fastlane/test_output/
ios/fastlane/.snapfile_diff.json
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
.swiftpm/

# Local development artifacts (2026-10-08)
# Secrets — root .env (no .local suffix) is the user's secret stash.
# Keep it out of git even though Next.js' default .gitignore only covers
# .env*.local. The previous gap was the .env file that pnpm/npm create
# when run with no install command.
/.env

# Serena MCP server cache (per-session, re-derivable from the project)
/.serena/

# Agent worktrees (separate from /claude/worktrees — created by
# sub-agents via isolation: "worktree" option)
.worktrees/

# Graphify knowledge graph output (AST-only, regenerated via `graphify update`).
# Lives at the repo root when `graphify update .` is run from here.
/graphify-out/

# Cloudflare security audit output (regenerable)
/audit-output/

# Storybook static export (regenerable via `pnpm build-storybook`)
/storybook-static/

# External iOS app bundle (untrusted upload from app store export — see
# CLAUDE.md "untrusted data" rule). Different from the real `ios/` dir
# which is the Xcode project; this is `ios-citymarkets/` (with a dash).
/ios-citymarkets/
/ios-citymarkets.zip
/ios-citymarkets-*.zip

# pnpm migration artefacts (2026-10-08). The project is currently on npm;
# these files were left behind by a half-completed migration. The
# workspace.yaml still has placeholder 'set this to true or false' values
# so committing them would break installs. If the project migrates to
# pnpm in the future, regenerate the workspace and re-init the lockfile.
/pnpm-lock.yaml
/pnpm-workspace.yaml

# One-off JWT-signing test script. Hardcoded dev DB password + JWT secret
# (kept out of the repo intentionally). Superseded by
# scripts/customer-journey-e2e.mjs which reads secrets from .env.local.
/scripts/jwt-test.mjs

# Storybook dev/build logs (rotated by storybook)
/*storybook.log
/storybook-static/

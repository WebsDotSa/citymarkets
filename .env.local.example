# Supabase (اختياري إن كان الدخول عبر JWT فقط؛ عند الغياب يُعتمد اعتماد العميل على كوكي الجلسة فقط)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# JWT عميل وTwilio OTP — مطلوب في الإنتاج
JWT_SECRET=min-32-char-random-secret
# JWT لوحة الإدارة (مطلوب في الإنتاج — بدون قيمة احتياطية)
ADMIN_JWT_SECRET=min-32-char-random-admin-secret
# JWT بوابة التجار (مطلوب في الإنتاج — يجب أن يختلف عن ADMIN_JWT_SECRET)
VENDOR_JWT_SECRET=min-32-char-random-vendor-secret

# المصادقة القديمة /api/v1/auth/login و verify — معطّلة في الإنتاج ما لم يُضبَط true صراحة (غير مستحسن)
# ALLOW_LEGACY_PHONE_OTP=true

# Database (for Drizzle migrations)
DATABASE_URL=postgresql://user:password@host:5432/citymarket

# Claude AI
CLAUDE_API_KEY=your_claude_api_key

# OpenAI (مساعد الذكاء الاصطناعي /ai-chat)
OPENAI_API_KEY=your_openai_api_key

# =======================================================================
# Apple App Store Review Account (server-only — never expose to client)
# =======================================================================
# Phone must be in Twilio E.164 format. 0555555555 (local) → +966555555555.
# OTP is checked server-side; iOS app must not hard-code it.
APPLE_REVIEW_ENABLED=false
APPLE_REVIEW_PHONE=+966555555555
APPLE_REVIEW_OTP=change_me_in_env_local
APPLE_REVIEW_NAME=Apple Reviewer

# بوابة الدفع: moyasar (ميسر) — المزوّد الوحيد للدفع الإلكتروني
PAYMENT_PROVIDER=moyasar
NEXT_PUBLIC_SITE_URL=https://citymarkets.sa

# Moyasar (ميسر) — https://docs.moyasar.com/
MOYASAR_SECRET_KEY=sk_test_xxxxxxxx
MOYASAR_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# MOYASAR_API_BASE_URL=https://api.moyasar.com/v1
# Moyasar webhook secret for verifying payment webhooks
MOYASAR_WEBHOOK_SECRET=your_webhook_secret

# Apple Pay domain verification (Moyasar): place file at public/.well-known/apple-developer-merchantid-domain-association
# or set APPLE_PAY_DOMAIN_ASSOCIATION_PATH=/absolute/path/to/file

# Tamara (تمارا — BNPL) — https://docs.tamara.co/
# مفتاح API من لوحة تحكم تمارا. عند الغياب يُعطّل خيار تمارا في checkout.
TAMARA_API_TOKEN=
# توكن التحقق من إشعارات تمارا (Authorization: Bearer <token>) — مطلوب في الإنتاج.
TAMARA_WEBHOOK_TOKEN=
# البيئة: اتركها فارغة لاستخدام sandbox (افتراضي). عيّنها 'live' للإنتاج.
# TAMARA_ENV=sandbox
# رابط API (يُحسَب تلقائياً حسب TAMARA_ENV، لكن يمكن تجاوزه يدوياً).
# TAMARA_API_BASE_URL=https://api-sandbox.tamara.co

# OneSignal
NEXT_PUBLIC_ONESIGNAL_APP_ID=your_onesignal_app_id

# Structured logging — optional Postgres query timing in production (never logs SQL nor param values).
# Leave unset unless debugging slow queries against a staging mirror.
DB_QUERY_LOG=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# إشعارات SMS (تأكيد الطلب، تنبيهات) عبر Messaging Service
TWILIO_MESSAGING_SERVICE_SID=

# Sentry APM (اختياري) — https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@sentry.io/xxxxx
SENTRY_DSN=https://xxxx@sentry.io/xxxxx
LOG_LEVEL=INFO
# النسب: production=0.05, staging=0.2, development=1.0
SENTRY_TRACES_SAMPLE_RATE=0.05

# Redis — للإنتاج الموزّع (اختياري)
# يُستخدم لـ rate limiting الموزّع. عند الغياب يُستخدم in-memory (يكفي لخادم واحد).
REDIS_URL=redis://localhost:6379

# ============================================================
# مركز بث الإشعارات (Notifications Broadcast Center) — PR1
# ============================================================

# Web Push (VAPID) — موجود مسبقاً، تأكد من القيم
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@citymarkets.sa

# Email Pro عبر Resend — مطلوب لتفعيل قناة البريد
# https://resend.com/docs/api-reference/emails/send-email
RESEND_API_KEY=
RESEND_FROM=City Markets <noreply@citymarkets.sa>
RESEND_REPLY_TO=support@citymarkets.sa

# Native Push (APNs + FCM) — اختياري؛ يُعطّل قناة native_push عند الغياب
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.citymarkets.app
# APNS_KEY_PATH=
# APNS_ENVIRONMENT=production

# FCM v1 (مفضّل) — مسار ملف service account
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_JSON=
# FCM_SERVER_KEY=   # legacy HTTP API — يعمل أيضاً

# توقيع روابط تتبّع البريد (HMAC). يُولّد تلقائياً بقيمة احتياطية للتطوير.
BROADCAST_TRACK_SECRET=

# ═══════════════════════════════════════════════════════════════
# PII Encryption (P0-3, security audit 2026-10-03)
# Required for application-level AES-256-GCM encryption of PII
# columns at rest. Without these, src/lib/security/pii-crypto.ts
# will throw on first use.
#
# Generate fresh keys with:
#   node -e "console.log('PII_ENCRYPTION_KEY=' + require('crypto').randomBytes(32).toString('base64'))"
#   node -e "console.log('PII_HMAC_KEY=' + require('crypto').randomBytes(32).toString('base64'))"
# ═══════════════════════════════════════════════════════════════
# PII_ENCRYPTION_KEY=
# PII_HMAC_KEY=
